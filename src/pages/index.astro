<!-- PROCESS -->
<section style="padding:96px 24px;background:#EDF4F4;">
  <div style="max-width:1020px;margin:0 auto;text-align:center;">
    <span class="kicker">How It Works</span>
    <h2 class="section-heading" style="font-size:clamp(26px,3.4vw,38px);margin:0 0 44px;">Three Steps. Most Repairs Done Same Day.</h2>
    <div class="steps-grid" style="display:grid;grid-template-columns:repeat(3,1fr);gap:32px;">
      <div style="background:#fff;border-radius:16px;padding:34px 26px;box-shadow:0 4px 18px rgba(10,61,92,0.08);">
        <div style="width:54px;height:54px;border-radius:50%;background:#C63D2F;color:#fff;font-family:'Open Sans',sans-serif;font-size:22px;font-weight:800;display:flex;align-items:center;justify-content:center;margin:0 auto 16px;">1</div>
        <h3 style="font-family:'Open Sans',sans-serif;font-size:18px;font-weight:700;color:#0E4F5C;margin:0 0 10px;">Call or send a photo of your tag</h3>
        <p style="font-size:14.5px;line-height:1.7;color:#55616B;margin:0;">Ring (709) 800-3117 or email a photo of the HOST tag to info@harbourtank.ca. We'll read the expiry date, ask a few questions about the tank and set a time to come by.</p>
      </div>
      <div style="background:#fff;border-radius:16px;padding:34px 26px;box-shadow:0 4px 18px rgba(10,61,92,0.08);">
        <div style="width:54px;height:54px;border-radius:50%;background:#C63D2F;color:#fff;font-family:'Open Sans',sans-serif;font-size:22px;font-weight:800;display:flex;align-items:center;justify-content:center;margin:0 auto 16px;">2</div>
        <h3 style="font-family:'Open Sans',sans-serif;font-size:18px;font-weight:700;color:#0E4F5C;margin:0 0 10px;">Free written estimate</h3>
        <p style="font-size:14.5px;line-height:1.7;color:#55616B;margin:0;">We check the tank, stand, pad and furnace line, then put the price in writing. Steel, fibreglass or removal only, your call, no pressure.</p>
      </div>
      <div style="background:#fff;border-radius:16px;padding:34px 26px;box-shadow:0 4px 18px rgba(10,61,92,0.08);">
        <div style="width:54px;height:54px;border-radius:50%;background:#C63D2F;color:#fff;font-family:'Open Sans',sans-serif;font-size:22px;font-weight:800;display:flex;align-items:center;justify-content:center;margin:0 auto 16px;">3</div>
        <h3 style="font-family:'Open Sans',sans-serif;font-size:18px;font-weight:700;color:#0E4F5C;margin:0 0 10px;">Swap, tag and rebook your delivery</h3>
